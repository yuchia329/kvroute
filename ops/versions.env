# Pinned engine configuration. This file is the single source of truth for
# everything that must not drift between benchmark cells.
#
# A dependency bump elsewhere on the box would silently invalidate completed
# cells, so vLLM lives in a venv dedicated to this project and its version is
# asserted at replica startup.

# Project-dedicated venv, created with uv. Never share it with other work.
VENV="${VENV:-$HOME/.venvs/kvroute}"

# Engine version, asserted against the venv before a replica starts.
VLLM_VERSION="0.28.0"

# The model, taken from the HF cache snapshot. Do NOT point this at
# ~/Meta-Llama-3.1-8B-Instruct-AWQ-INT4: those safetensors are 135-byte git-lfs
# pointer stubs.
MODEL="hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4"

# The AWQ kernel is forced rather than auto-selected, so it cannot flip between
# runs and quietly change what the policy comparison is measuring.
#
# 0.28.0 auto-selects in TWO independent places, so both are pinned:
#
#  1. --quantization picks the quantization config class. Left unset, the
#     model's own quantization_config is read and the auto_awq path decides
#     whether to upgrade AWQ to Marlin. Confirmed on the box that awq_marlin is
#     a registered method and is NOT in DEPRECATED_QUANTIZATION_METHODS.
#  2. --linear-backend picks the GEMM kernel for quantized linear layers and
#     defaults to "auto", described in the engine's own help as "automatically
#     select the best backend based on model and hardware". Pinning the method
#     alone would leave this one free to choose.
QUANTIZATION="awq_marlin"
LINEAR_BACKEND="marlin"

# Startup asserts the engine log confirms the forced backend, so a version that
# ignores or renames the flag fails loudly instead of silently running another
# kernel. Widen this pattern here if the engine's log wording changes.
QUANTIZATION_LOG_PATTERN="awq[_: ]?marlin"

# Held constant across every policy: only the router varies between cells.
# Chunked prefill is stated explicitly because it trades TTFT against ITL and so
# partly determines which policy looks good.
GPU_MEMORY_UTILIZATION="0.9"
MAX_NUM_SEQS="256"
BLOCK_SIZE="16"
MAX_MODEL_LEN="8192"
ENABLE_PREFIX_CACHING="1"
ENABLE_CHUNKED_PREFILL="1"

# KV residency metrics (block lifetime, idle-before-evict, reuse gap) are off by
# default and are what lets the prefix index's TTL be calibrated against how
# fast replicas actually evict, rather than guessed. They are sampled at 1% so
# the overhead is small. Enabled now rather than later: turning them on
# mid-experiment would change the engine configuration that every cell is
# supposed to share.
KV_CACHE_METRICS="1"

# vLLM's FlashInfer sampler JIT-compiles a CUDA kernel on first use, which needs
# nvcc on PATH and puts a compile step — plus a JIT cache that can differ
# between runs — inside every replica launch. Six staggered replicas would pay
# it six times, and a cell whose engine compiled its own sampler is not
# obviously comparable to one that did not. The PyTorch sampler is used instead,
# held constant like every other engine setting.
VLLM_USE_FLASHINFER_SAMPLER="0"

# Ports 8000..8005, one per GPU.
BASE_PORT="8000"

# PID files, logs and startup evidence.
RUN_DIR="${RUN_DIR:-run}"

# How long to wait for a replica to load the model and answer /health.
STARTUP_TIMEOUT_SECONDS="600"
