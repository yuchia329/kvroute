# Pinned engine configuration. This file is the single source of truth for
# everything that must not drift between benchmark cells.
#
# A dependency bump elsewhere on the box would silently invalidate completed
# cells, so vLLM lives in a venv dedicated to this project and its version is
# asserted at replica startup.

# Project-dedicated venv, created with uv. Never share it with other work.
VENV="${VENV:-$HOME/.venvs/kvroute}"

# Engine version, asserted against the venv before a replica starts.
VLLM_VERSION="0.28.0"

# The model, taken from the HF cache snapshot. Do NOT point this at
# ~/Meta-Llama-3.1-8B-Instruct-AWQ-INT4: those safetensors are 135-byte git-lfs
# pointer stubs.
MODEL="hugging-quants/Meta-Llama-3.1-8B-Instruct-AWQ-INT4"

# The AWQ kernel is forced rather than auto-selected: per idea.md, vLLM 0.28.0's
# auto_awq path picks Marlin on its own, and pinning it means it cannot flip
# between runs and quietly change what the policy comparison is measuring.
#
# UNVERIFIED against the box: this flag spelling has not been run on a live
# engine. If 0.28.0 names the forced backend differently, startup will fail on
# the assertion below, which is the intended way to find out.
QUANTIZATION="awq_marlin"

# Startup asserts the engine log confirms the forced backend, so a version that
# ignores or renames the flag fails loudly instead of silently running another
# kernel. Widen this pattern here if the engine's log wording changes.
QUANTIZATION_LOG_PATTERN="awq[_: ]?marlin"

# Held constant across every policy: only the router varies between cells.
# Chunked prefill is stated explicitly because it trades TTFT against ITL and so
# partly determines which policy looks good.
GPU_MEMORY_UTILIZATION="0.9"
MAX_NUM_SEQS="256"
BLOCK_SIZE="16"
MAX_MODEL_LEN="8192"
ENABLE_PREFIX_CACHING="1"
ENABLE_CHUNKED_PREFILL="1"

# Ports 8000..8005, one per GPU.
BASE_PORT="8000"

# PID files, logs and startup evidence.
RUN_DIR="${RUN_DIR:-run}"

# How long to wait for a replica to load the model and answer /health.
STARTUP_TIMEOUT_SECONDS="600"
